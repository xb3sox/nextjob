{
  "name": "nextjob",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "extension"
  ],
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "vite",
    "build": "vite build && wxt build extension",
    "build:extension": "wxt build extension",
    "registry:build": "bunx shadcn@latest build registry.json -o public/r",
    "registry:validate": "bunx shadcn@latest registry validate registry.json",
    "preview": "vite preview",
    "typecheck": "wxt prepare extension && tsc --noEmit && tsc --noEmit -p extension/tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --apply .",
    "test": "vitest",
    "test:eval": "vitest run --project node evals",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --apply .",
    "hooks:install": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@supabase/supabase-js": "^2.98.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "langfuse": "^3.39.2",
    "lucide-react": "^0.294.0",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "tailwind-merge": "^3.7.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/vite": "^4.1.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.3",
    "bun-types": "^1.4.2",
    "drizzle-kit": "^0.31.11",
    "express": "^5.3.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.0",
    "vite": "^6.4.4",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  },
  "overrides": {
    "body-parser": "^2.4.0",
    "jsondiffpatch": "^0.7.6",
    "nanoid": "^3.3.20",
    "source-map-js": "^1.2.2",
    "undici": "^8.12.3"
  }
}
