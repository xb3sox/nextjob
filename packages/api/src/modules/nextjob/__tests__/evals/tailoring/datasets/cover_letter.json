{
  "dataset": "cover_letter",
  "description": "Cover letter generation test cases with evidence constraints",
  "version": "1.0.0",
  "testCases": [
    {
      "id": "cl-001",
      "description": "Generate cover letter with experience evidence",
      "careerGraph": {
        "claims": [
          {
            "id": "claim-1",
            "type": "experience",
            "title": "Senior Software Engineer",
            "content": {
              "company": "Tech Corp",
              "startDate": "2020-01-01",
              "endDate": "2023-12-31",
              "achievements": ["Led team of 5 engineers", "Improved system performance by 40%"]
            },
            "evidenceId": "evidence-1",
            "verificationStatus": "verified",
            "confidence": 0.95
          }
        ]
      },
      "jobRequirements": {
        "title": "Software Engineer",
        "company": "Innovate Inc",
        "description": "Looking for experienced software engineer to lead projects"
      },
      "tailoringType": "cover_letter",
      "expectedOutput": {
        "sections": [
          {
            "type": "introduction",
            "content": "I am writing to express my interest in the Software Engineer position at Innovate Inc",
            "evidenceClaimIds": []
          },
          {
            "type": "experience",
            "content": "As a Senior Software Engineer at Tech Corp, I led a team of 5 engineers and improved system performance by 40%",
            "evidenceClaimIds": ["claim-1"]
          }
        ],
        "unsupportedClaims": [],
        "evidenceCoverage": 1.0
      }
    },
