{
  "dataset": "resume_tailoring",
  "description": "Resume tailoring test cases with evidence constraints",
  "version": "1.0.0",
  "testCases": [
    {
      "id": "rt-001",
      "description": "Tailor resume with complete experience evidence",
      "careerGraph": {
        "claims": [
          {
            "id": "claim-1",
            "type": "experience",
            "title": "Senior Software Engineer",
            "content": {
              "company": "Tech Corp",
              "startDate": "2020-01-01",
              "endDate": "2023-12-31",
              "location": "San Francisco, CA",
              "achievements": ["Led team of 5 engineers", "Improved system performance by 40%"]
            },
            "evidenceId": "evidence-1",
            "verificationStatus": "verified",
            "confidence": 0.95
          }
        ]
      },
      "jobRequirements": {
        "title": "Software Engineer",
        "requiredSkills": ["JavaScript", "React"],
        "experience": "3+ years",
        "description": "Looking for experienced software engineer"
      },
      "tailoringType": "resume",
      "expectedOutput": {
        "sections": [
          {
            "type": "experience",
            "content": "Senior Software Engineer at Tech Corp",
            "evidenceClaimId": "claim-1",
            "preserved": ["company", "startDate", "endDate", "achievements"]
          }
        ],
        "unsupportedClaims": [],
        "evidenceCoverage": 1.0
      }
    },
    {
