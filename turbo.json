{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "inputs": [
        "src/**",
        "public/**",
        "package.json",
        "tsconfig.json",
        "vite.config.ts",
        "tailwind.config.*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": ["src/**", "test/**", "vitest.config.ts"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": ["src/**", "test/**", "vitest.config.ts"]
    },
    "lint": {
      "outputs": [],
      "inputs": ["src/**", "biome.json", ".eslintrc*"]
    },
    "lint:fix": {
      "outputs": [],
      "inputs": ["src/**", "biome.json", ".eslintrc*"]
    },
    "format": {
      "outputs": [],
      "inputs": ["src/**", "biome.json"]
    },
    "format:check": {
      "outputs": [],
      "inputs": ["src/**", "biome.json"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["src/**", "tsconfig.json"]
    },
    "check": {
      "dependsOn": ["lint", "typecheck", "format:check"],
      "outputs": []
    }
  }
}
