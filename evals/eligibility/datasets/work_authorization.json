{
  "dataset": "work_authorization",
  "description": "Work authorization eligibility test cases",
  "version": "1.0.0",
  "testCases": [
    {
      "id": "wa-001",
      "description": "US citizen with valid authorization",
      "userProfile": {
        "workAuthorization": {
          "authorizations": ["US Citizen"]
        }
      },
      "job": {},
      "rules": [
        {
          "checkType": "work_authorization",
          "condition": {
            "requiredAuthorizations": ["US Citizen", "Green Card"]
          },
          "required": true
        }
      ],
      "expectedOutcome": {
        "status": "eligible",
        "confidence": 1.0,
        "checks": [
          {
            "type": "work_authorization",
            "status": "eligible",
            "required": true
          }
        ]
      }
    },
    {
      "id": "wa-002",
      "description": "Green card holder with valid authorization",
      "userProfile": {
        "workAuthorization": {
          "authorizations": ["Green Card"]
        }
      },
      "job": {},
      "rules": [
        {
          "checkType": "work_authorization",
          "condition": {
            "requiredAuthorizations": ["US Citizen", "Green Card"]
          },
          "required": true
        }
      ],
      "expectedOutcome": {
        "status": "eligible",
        "confidence": 1.0,
        "checks": [
          {
            "type": "work_authorization",
            "status": "eligible",
            "required": true
          }
        ]
      }
    },
    {
      "id": "wa-003",
      "description": "H1B visa holder - not authorized for US-only jobs",
      "userProfile": {
        "workAuthorization": {
          "authorizations": ["H1B Visa"]
        }
      },
      "job": {},
      "rules": [
        {
          "checkType": "work_authorization",
          "condition": {
            "requiredAuthorizations": ["US Citizen", "Green Card"]
          },
          "required": true
        }
      ],
      "expectedOutcome": {
        "status": "ineligible",
        "confidence": 1.0,
        "checks": [
          {
            "type": "work_authorization",
            "status": "ineligible",
            "required": true,
            "reason": "User does not have required work authorization"
          }
        ],
        "missingRequirements": ["User does not have required work authorization"]
      }
    },
