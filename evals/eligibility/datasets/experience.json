{
  "dataset": "experience",
  "description": "Experience requirement eligibility test cases",
  "version": "1.0.0",
  "testCases": [
    {
      "id": "ex-001",
      "description": "User has exactly required years of experience",
      "userProfile": { "experience": [{ "startDate": "2018-01-01", "endDate": "2023-01-01" }] },
      "job": {},
      "rules": [{ "checkType": "experience", "condition": { "minimumYears": 5 }, "required": true }],
      "expectedOutcome": { "status": "eligible", "confidence": 1.0, "checks": [{ "type": "experience", "status": "eligible", "required": true }] }
    },
    {
      "id": "ex-002",
      "description": "User has more than required years of experience",
      "userProfile": { "experience": [{ "startDate": "2015-01-01", "endDate": "2023-01-01" }] },
      "job": {},
      "rules": [{ "checkType": "experience", "condition": { "minimumYears": 5 }, "required": true }],
      "expectedOutcome": { "status": "eligible", "confidence": 1.0, "checks": [{ "type": "experience", "status": "eligible", "required": true }] }
    },
    {
      "id": "ex-003",
      "description": "User has less than required years of experience",
      "userProfile": { "experience": [{ "startDate": "2020-01-01", "endDate": "2023-01-01" }] },
      "job": {},
      "rules": [{ "checkType": "experience", "condition": { "minimumYears": 5 }, "required": true }],
      "expectedOutcome": { "status": "ineligible", "confidence": 1.0, "checks": [{ "type": "experience", "status": "ineligible", "required": true, "reason": "User has 3.0 years of experience, but 5 required" }], "missingRequirements": ["User has 3.0 years of experience, but 5 required"] }
    },
    {
      "id": "ex-004",
      "description": "User has no experience info - should return unknown",
      "userProfile": {},
      "job": {},
      "rules": [{ "checkType": "experience", "condition": { "minimumYears": 5 }, "required": true }],
      "expectedOutcome": { "status": "unknown", "confidence": 0.0, "checks": [{ "type": "experience", "status": "unknown", "required": true, "reason": "User has 0.0 years of experience, but 5 required" }], "warnings": ["Unable to verify experience"] }
    },
    {
      "id": "ex-005",
      "description": "Current job (no endDate)",
      "userProfile": { "experience": [{ "startDate": "2018-01-01" }] },
      "job": {},
      "rules": [{ "checkType": "experience", "condition": { "minimumYears": 5 }, "required": true }],
      "expectedOutcome": { "status": "eligible", "confidence": 1.0, "checks": [{ "type": "experience", "status": "eligible", "required": true }] }
    },
    {
      "id": "ex-006",
      "description": "Multiple jobs - total experience meets requirement",
      "userProfile": { "experience": [{ "startDate": "2018-01-01", "endDate": "2020-01-01" }, { "startDate": "2020-01-01", "endDate": "2023-01-01" }] },
      "job": {},
      "rules": [{ "checkType": "experience", "condition": { "minimumYears": 5 }, "required": true }],
      "expectedOutcome": { "status": "eligible", "confidence": 1.0, "checks": [{ "type": "experience", "status": "eligible", "required": true }] }
    },
    {
      "id": "ex-007",
      "description": "Optional experience rule",
      "userProfile": { "experience": [{ "startDate": "2020-01-01", "endDate": "2023-01-01" }] },
      "job": {},
      "rules": [{ "checkType": "experience", "condition": { "minimumYears": 5 }, "required": false }],
      "expectedOutcome": { "status": "eligible", "confidence": 1.0, "checks": [{ "type": "experience", "status": "ineligible", "required": false, "reason": "User has 3.0 years of experience, but 5 required" }] }
    },
    {
      "id": "ex-008",
      "description": "No minimum years specified - should pass",
      "userProfile": { "experience": [{ "startDate": "2020-01-01", "endDate": "2023-01-01" }] },
      "job": {},
      "rules": [{ "checkType": "experience", "condition": {}, "required": true }],
      "expectedOutcome": { "status": "eligible", "confidence": 1.0, "checks": [{ "type": "experience", "status": "eligible", "required": true }] }
    },
    {
      "id": "ex-009",
      "description": "Experience with missing startDate",
      "userProfile": { "experience": [{ "endDate": "2023-01-01" }] },
      "job": {},
      "rules": [{ "checkType": "experience", "condition": { "minimumYears": 5 }, "required": true }],
      "expectedOutcome": { "status": "ineligible", "confidence": 1.0, "checks": [{ "type": "experience", "status": "ineligible", "required": true, "reason": "User has 0.0 years of experience, but 5 required" }], "missingRequirements": ["User has 0.0 years of experience, but 5 required"] }
    },
    {
      "id": "ex-010",
      "description": "Zero years of experience required",
      "userProfile": { "experience": [] },
      "job": {},
      "rules": [{ "checkType": "experience", "condition": { "minimumYears": 0 }, "required": true }],
      "expectedOutcome": { "status": "eligible", "confidence": 1.0, "checks": [{ "type": "experience", "status": "eligible", "required": true }] }
    }
  ]
}
