{
  "dataset": "language",
  "description": "Language proficiency eligibility test cases",
  "version": "1.0.0",
  "testCases": [
    {
      "id": "la-001",
      "description": "User has required language at required proficiency",
      "userProfile": { "languages": [{ "language": "English", "proficiency": "professional" }] },
      "job": {},
      "rules": [{ "checkType": "language", "condition": { "requiredLanguages": [{ "language": "English", "proficiency": "professional" }] }, "required": true }],
      "expectedOutcome": { "status": "eligible", "confidence": 1.0, "checks": [{ "type": "language", "status": "eligible", "required": true }] }
    },
    {
      "id": "la-002",
      "description": "User has higher proficiency than required",
      "userProfile": { "languages": [{ "language": "English", "proficiency": "fluent" }] },
      "job": {},
      "rules": [{ "checkType": "language", "condition": { "requiredLanguages": [{ "language": "English", "proficiency": "professional" }] }, "required": true }],
      "expectedOutcome": { "status": "eligible", "confidence": 1.0, "checks": [{ "type": "language", "status": "eligible", "required": true }] }
    },
    {
      "id": "la-003",
      "description": "User has lower proficiency than required",
      "userProfile": { "languages": [{ "language": "English", "proficiency": "intermediate" }] },
      "job": {},
      "rules": [{ "checkType": "language", "condition": { "requiredLanguages": [{ "language": "English", "proficiency": "professional" }] }, "required": true }],
      "expectedOutcome": { "status": "ineligible", "confidence": 1.0, "checks": [{ "type": "language", "status": "ineligible", "required": true, "reason": "User does not have required language proficiency" }], "missingRequirements": ["User does not have required language proficiency"] }
    },
    {
      "id": "la-004",
      "description": "User doesn't have required language",
      "userProfile": { "languages": [{ "language": "Spanish", "proficiency": "fluent" }] },
      "job": {},
      "rules": [{ "checkType": "language", "condition": { "requiredLanguages": [{ "language": "English", "proficiency": "professional" }] }, "required": true }],
      "expectedOutcome": { "status": "ineligible", "confidence": 1.0, "checks": [{ "type": "language", "status": "ineligible", "required": true, "reason": "User does not have required language proficiency" }], "missingRequirements": ["User does not have required language proficiency"] }
    },
    {
      "id": "la-005",
      "description": "No language info - should return unknown",
      "userProfile": {},
      "job": {},
      "rules": [{ "checkType": "language", "condition": { "requiredLanguages": [{ "language": "English", "proficiency": "professional" }] }, "required": true }],
      "expectedOutcome": { "status": "unknown", "confidence": 0.0, "checks": [{ "type": "language", "status": "unknown", "required": true, "reason": "User does not have required language proficiency" }], "warnings": ["Unable to verify language"] }
    },
    {
      "id": "la-006",
      "description": "Multiple required languages - user has all",
      "userProfile": { "languages": [{ "language": "English", "proficiency": "fluent" }, { "language": "Spanish", "proficiency": "professional" }] },
      "job": {},
      "rules": [{ "checkType": "language", "condition": { "requiredLanguages": [{ "language": "English", "proficiency": "professional" }, { "language": "Spanish", "proficiency": "intermediate" }] }, "required": true }],
      "expectedOutcome": { "status": "eligible", "confidence": 1.0, "checks": [{ "type": "language", "status": "eligible", "required": true }] }
    },
    {
      "id": "la-007",
      "description": "Multiple required languages - user missing one",
      "userProfile": { "languages": [{ "language": "English", "proficiency": "fluent" }] },
      "job": {},
      "rules": [{ "checkType": "language", "condition": { "requiredLanguages": [{ "language": "English", "proficiency": "professional" }, { "language": "Spanish", "proficiency": "intermediate" }] }, "required": true }],
      "expectedOutcome": { "status": "ineligible", "confidence": 1.0, "checks": [{ "type": "language", "status": "ineligible", "required": true, "reason": "User does not have required language proficiency" }], "missingRequirements": ["User does not have required language proficiency"] }
    },
    {
      "id": "la-008",
      "description": "Case-insensitive language matching",
      "userProfile": { "languages": [{ "language": "english", "proficiency": "professional" }] },
      "job": {},
      "rules": [{ "checkType": "language", "condition": { "requiredLanguages": [{ "language": "English", "proficiency": "professional" }] }, "required": true }],
      "expectedOutcome": { "status": "eligible", "confidence": 1.0, "checks": [{ "type": "language", "status": "eligible", "required": true }] }
    },
    {
      "id": "la-009",
      "description": "Optional language rule",
      "userProfile": { "languages": [{ "language": "Spanish", "proficiency": "intermediate" }] },
      "job": {},
      "rules": [{ "checkType": "language", "condition": { "requiredLanguages": [{ "language": "English", "proficiency": "professional" }] }, "required": false }],
      "expectedOutcome": { "status": "eligible", "confidence": 1.0, "checks": [{ "type": "language", "status": "ineligible", "required": false, "reason": "User does not have required language proficiency" }] }
    },
    {
      "id": "la-010",
      "description": "No required languages specified - should pass",
      "userProfile": { "languages": [{ "language": "English", "proficiency": "fluent" }] },
      "job": {},
      "rules": [{ "checkType": "language", "condition": {}, "required": true }],
      "expectedOutcome": { "status": "eligible", "confidence": 1.0, "checks": [{ "type": "language", "status": "eligible", "required": true }] }
    }
  ]
}
