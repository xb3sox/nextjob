{
  "scenario": "evidence_partial",
  "description": "Test cases with partial evidence coverage",
  "version": "1.0.0",
  "testCases": [
    {
      "id": "ep-001",
      "description": "Partial evidence - missing skills",
      "careerGraph": {
        "claims": [
          {
            "id": "claim-1",
            "type": "experience",
            "title": "Developer",
            "content": {
              "company": "TechCo",
              "years": 3
            },
            "evidenceId": "evidence-1",
            "verificationStatus": "verified",
            "confidence": 0.95
          }
        ]
      },
      "jobRequirements": {
        "title": "Software Engineer",
        "requiredSkills": ["JavaScript", "React", "Node.js"]
      },
      "tailoringType": "resume",
      "expectedOutput": {
        "sections": [
          {
            "type": "experience",
            "content": "Developer at TechCo (3 years)",
            "evidenceClaimId": "claim-1"
          }
        ],
        "unsupportedClaims": [],
        "missingSkills": ["JavaScript", "React", "Node.js"],
        "evidenceCoverage": 0.5
      }
    },
    {
